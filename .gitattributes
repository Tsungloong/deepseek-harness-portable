# Normalize text files to LF; per-type overrides below.
* text=auto eol=lf

*.sh text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary

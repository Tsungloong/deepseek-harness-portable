# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 允许行尾双空格表示换行
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.sh]
end_of_line = lf
